{
  "name": "@kiril6/termdeck",
  "version": "1.3.0",
  "description": "A browser cockpit of floating, draggable terminal windows — each backed by a real shell (PTY) on your machine. Tile, group into projects, theme, reconnect without losing a session.",
  "main": "server.js",
  "bin": {
    "termdeck": "server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "terminal",
    "pty",
    "shell",
    "xterm",
    "tmux",
    "dashboard",
    "web-terminal",
    "cli",
    "node-pty",
    "localhost"
  ],
  "files": [
    "server.js",
    "install.js",
    "public",
    "scripts",
    "FEATURES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kiril6/termdeck.git"
  },
  "bugs": {
    "url": "https://github.com/kiril6/termdeck/issues"
  },
  "homepage": "https://github.com/kiril6/termdeck#readme",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "setup": "node install.js",
    "build:demo": "node scripts/build-demo.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-serialize": "^0.11.0",
    "xterm-addon-web-links": "^0.9.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0",
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1"
  }
}
