{
  "name": "@kiril6/termdeck",
  "version": "1.27.0",
  "description": "Local-first browser cockpit for running AI coding agents (Claude Code, Codex, Gemini) and shells in floating windows backed by real PTYs. Git worktree per agent, approval alerts, sessions that survive restarts.",
  "main": "server.js",
  "bin": {
    "termdeck": "server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "terminal",
    "pty",
    "shell",
    "xterm",
    "tmux",
    "dashboard",
    "web-terminal",
    "cli",
    "node-pty",
    "localhost",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "git-worktree"
  ],
  "files": [
    "server.js",
    "install.js",
    "public",
    "scripts/access.js",
    "scripts/agent-api.js",
    "scripts/approval-rules.js",
    "scripts/autostart.js",
    "scripts/cli.js",
    "scripts/doctor.js",
    "scripts/fs-api.js",
    "scripts/git-api.js",
    "scripts/hooks.js",
    "scripts/http-security.js",
    "scripts/json-store.js",
    "scripts/layouts-api.js",
    "scripts/notify.js",
    "scripts/open-browser.js",
    "scripts/sessions.js",
    "scripts/td-hook.js",
    "scripts/uninstall.js",
    "scripts/update-check.js",
    "FEATURES.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kiril6/termdeck.git"
  },
  "bugs": {
    "url": "https://github.com/kiril6/termdeck/issues"
  },
  "homepage": "https://github.com/kiril6/termdeck#readme",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "setup": "node install.js",
    "build:demo": "node scripts/build-demo.js",
    "lint": "eslint .",
    "release": "node scripts/release.js",
    "test": "playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "espree": "^11.2.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0"
  }
}
