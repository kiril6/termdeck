{
  "name": "TermDeck",
  "short_name": "TermDeck",
  "description": "Floating xterm.js terminal windows in the browser, each a real PTY on your host.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e151d",
  "theme_color": "#0e151d",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
